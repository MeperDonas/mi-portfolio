---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import LanguageToggle from '../components/LanguageToggle.astro';
import SiteNav from '../components/SiteNav.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Certifications from '../components/Certifications.astro';
import {
  getAbout,
  getCertifications,
  getExperience,
  getProjects,
  getSite,
} from '../lib/content';

const [
  aboutEs,
  aboutEn,
  experienceEs,
  experienceEn,
  projectsEs,
  projectsEn,
  certificationsEs,
  certificationsEn,
  siteEs,
  siteEn,
] = await Promise.all([
  getAbout('es'),
  getAbout('en'),
  getExperience('es'),
  getExperience('en'),
  getProjects('es'),
  getProjects('en'),
  getCertifications('es'),
  getCertifications('en'),
  getSite('es'),
  getSite('en'),
]);

const es = siteEs[0];
const en = siteEn[0];

const brand = es.data.name;
const title = `${brand} — ${es.data.role}`;
const description = es.data.role;

// Empty-shell suppression (spec REQ-01 "Empty section"): each locale's section
// block renders only when that locale has at least one entry. The outer anchor
// wrapper renders only when at least one locale has content.
const hasAboutEs = aboutEs.length > 0;
const hasAboutEn = aboutEn.length > 0;
const hasExperienceEs = experienceEs.length > 0;
const hasExperienceEn = experienceEn.length > 0;
const hasProjectsEs = projectsEs.length > 0;
const hasProjectsEn = projectsEn.length > 0;
const hasCertificationsEs = certificationsEs.length > 0;
const hasCertificationsEn = certificationsEn.length > 0;

// The vertical nav only shows items whose section actually renders (matches the
// empty-shell suppression above), so every nav link has a real deck target.
const navSections: { id: string; key: 'about' | 'experience' | 'projects' | 'certifications'; available: boolean }[] = [
  { id: 'about', key: 'about', available: hasAboutEs || hasAboutEn },
  { id: 'experience', key: 'experience', available: hasExperienceEs || hasExperienceEn },
  { id: 'projects', key: 'projects', available: hasProjectsEs || hasProjectsEn },
  { id: 'certifications', key: 'certifications', available: hasCertificationsEs || hasCertificationsEn },
];
const availableNavSections = navSections.filter((section) => section.available).map(({ id, key }) => ({ id, key }));

// Chapter numbers for the section eyebrows (01, 02, …), following deck order.
// Locale-independent, so they work for both copies without touching content.
const sectionIndex = new Map(availableNavSections.map(({ id }, i) => [id, String(i + 1).padStart(2, '0')]));

const year = new Date().getFullYear();
const cvFileEs = es.data.cv?.split('/').pop() ?? '';
const cvFileEn = en.data.cv?.split('/').pop() ?? '';
---

<Base title={title} description={description}>
  <!--
    Split layout: the left column holds identity + nav and stays fixed; the
    right column is a snap-scroll deck. On lg+ the page does not free-scroll
    (h-screen + overflow-hidden), only the deck scrolls internally. Below lg the
    two stack and the page scrolls naturally.

    The grid row must be an explicit minmax(0,1fr) track: with an auto row the
    lg:h-full children resolve against a circular height (content-sized), the
    deck never overflows internally and main clips it to one viewport with no
    scroll. minmax(0,1fr) gives a definite 100vh row so the deck really scrolls.
  -->
  <main
    class="mx-auto max-w-7xl lg:grid lg:h-screen lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:grid-rows-[minmax(0,1fr)] lg:gap-20 lg:overflow-hidden"
  >
    <!-- Identity + nav column: content aligned to the top. Static by design on
         lg+ (see .identity-col in global.css): vh-driven clamps compress the
         content on short viewports and overflow:hidden guarantees it never
         scrolls internally. -->
    <aside class="identity-col flex flex-col px-6 pb-8 pt-8 lg:h-full lg:min-h-0 lg:overflow-hidden lg:px-10 lg:py-10">
      <div class="flex items-center justify-between">
        <a
          href="#top"
          data-scroll-top
          aria-label="Top"
          class="flex items-center justify-center rounded-md p-1.5 text-ink-subtle transition-colors duration-200 hover:bg-surface-1 hover:text-ink"
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 19V5"></path>
            <path d="m5 12 7-7 7 7"></path>
          </svg>
        </a>
        <div class="flex items-center gap-2">
          <button
            type="button"
            data-cmdk-open
            aria-label="Command palette (Ctrl+K)"
            title="Ctrl+K"
            class="flex h-7 w-7 items-center justify-center rounded-md text-ink-subtle transition-colors duration-200 hover:bg-surface-1 hover:text-ink"
          >
            <svg
              class="h-3.5 w-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
            </svg>
          </button>
          <LanguageToggle />
        </div>
      </div>

      <div class="hero-wrap mt-10 lg:mt-14">
        <Hero
          locale="es"
          name={es.data.name}
          role={es.data.role}
          email={es.data.email}
          linkedin={es.data.linkedin}
          github={es.data.github}
          cv={es.data.cv}
        />
        <Hero
          locale="en"
          name={en.data.name}
          role={en.data.role}
          email={en.data.email}
          linkedin={en.data.linkedin}
          github={en.data.github}
          cv={en.data.cv}
          hidden
        />
      </div>

      <SiteNav nav={{ es: es.data.nav, en: en.data.nav }} items={availableNavSections} />
    </aside>

    <!-- Snap-scroll section deck (lg+). -->
    <div
      data-scroll-root
      class="split-scroller px-6 pb-16 lg:h-full lg:overflow-y-auto lg:px-10 lg:pb-0"
    >
      {(hasAboutEs || hasAboutEn) && (
        <div
          id="about"
          data-section
          class="deck-section lg:flex lg:min-h-full lg:flex-col"
        >
          {hasAboutEs && <About locale="es" index={sectionIndex.get('about') ?? '01'} entries={aboutEs} />}
          {hasAboutEn && <About locale="en" index={sectionIndex.get('about') ?? '01'} entries={aboutEn} hidden />}
        </div>
      )}

      {(hasExperienceEs || hasExperienceEn) && (
        <div
          id="experience"
          data-section
          class="deck-section lg:flex lg:min-h-full lg:flex-col"
        >
          {hasExperienceEs && (
            <Experience
              locale="es"
              index={sectionIndex.get('experience') ?? '02'}
              title={es.data.nav.experience}
              presentLabel="Actualidad"
              entries={experienceEs}
            />
          )}
          {hasExperienceEn && (
            <Experience
              locale="en"
              index={sectionIndex.get('experience') ?? '02'}
              title={en.data.nav.experience}
              presentLabel="Present"
              entries={experienceEn}
              hidden
            />
          )}
        </div>
      )}

      {(hasProjectsEs || hasProjectsEn) && (
        <div
          id="projects"
          data-section
          class="deck-section lg:flex lg:min-h-full lg:flex-col"
        >
          {hasProjectsEs && <Projects locale="es" index={sectionIndex.get('projects') ?? '03'} title={es.data.nav.projects} entries={projectsEs} />}
          {hasProjectsEn && <Projects locale="en" index={sectionIndex.get('projects') ?? '03'} title={en.data.nav.projects} entries={projectsEn} hidden />}
        </div>
      )}

      {(hasCertificationsEs || hasCertificationsEn) && (
        <div
          id="certifications"
          data-section
          class="deck-section lg:flex lg:min-h-full lg:flex-col"
        >
          {hasCertificationsEs && (
            <Certifications
              locale="es"
              index={sectionIndex.get('certifications') ?? '04'}
              title={es.data.nav.certifications}
              entries={certificationsEs}
            />
          )}
          {hasCertificationsEn && (
            <Certifications
              locale="en"
              index={sectionIndex.get('certifications') ?? '04'}
              title={en.data.nav.certifications}
              entries={certificationsEn}
              hidden
            />
          )}
        </div>
      )}

      <!-- Colophon: closes the page; not a snap point, so it can never trap
            the end of the deck. Both locale copies follow the data-locale pattern. -->
      <footer class="px-6">
        <div
          class="flex flex-col gap-3 border-t border-hairline pb-14 pt-8 sm:flex-row sm:items-center sm:justify-between"
          data-reveal
        >
          <p class="text-xs text-ink-subtle">
            <span data-locale="es">© {year} {es.data.name}. Diseñado y desarrollado con Astro y Tailwind CSS.</span>
            <span data-locale="en" hidden>© {year} {en.data.name}. Designed and built with Astro and Tailwind CSS.</span>
          </p>
          <a href={`mailto:${es.data.email}`} class="link-underline w-fit text-xs font-medium text-ink-subtle">
            <span data-locale="es">{es.data.nav.contact}</span>
            <span data-locale="en" hidden>{en.data.nav.contact}</span>
          </a>
        </div>
      </footer>
    </div>
  </main>

  {es.data.cv && (
    <div data-cv-modal data-cv-locale="es" class="cv-modal" hidden>
      <div class="cv-modal-backdrop" data-cv-close></div>
      <div class="cv-modal-panel">
        <div class="cv-modal-titlebar">
          <span>{cvFileEs}</span>
          <button type="button" data-cv-close aria-label="Close CV preview" class="cv-modal-close">
            <svg
              class="h-3.5 w-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M18 6 6 18M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <iframe
          src={`${es.data.cv}#navpanes=0&view=FitH`}
          title="Curriculum Vitae"
          class="cv-modal-frame"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  )}
  {en.data.cv && (
    <div data-cv-modal data-cv-locale="en" class="cv-modal" hidden>
      <div class="cv-modal-backdrop" data-cv-close></div>
      <div class="cv-modal-panel">
        <div class="cv-modal-titlebar">
          <span>{cvFileEn}</span>
          <button type="button" data-cv-close aria-label="Close CV preview" class="cv-modal-close">
            <svg
              class="h-3.5 w-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M18 6 6 18M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <iframe
          src={`${en.data.cv}#navpanes=0&view=FitH`}
          title="Resume"
          class="cv-modal-frame"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  )}

  <!-- Command palette (Ctrl/Cmd+K): sections + quick actions. Labels follow
       the data-locale pattern so the i18n toggle keeps them in sync. -->
  <div class="cmdk" data-cmdk hidden>
    <div class="cmdk-backdrop" data-cmdk-close></div>
    <div class="cmdk-panel" role="dialog" aria-modal="true" aria-label="Command palette">
      <input
        data-cmdk-input
        type="text"
        autocomplete="off"
        spellcheck="false"
        aria-label="Search commands"
        placeholder="Escribí un comando…"
      />
      <ul class="cmdk-list" data-cmdk-list role="listbox" aria-label="Commands">
        <li role="presentation">
          <button type="button" class="cmdk-item" role="option" data-cmdk-item data-cmdk-goto="about">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"></path><path d="M5 10v10h14V10"></path></svg>
            <span class="flex-1 text-left"><span data-locale="es">Sobre mí</span><span data-locale="en" hidden>About</span></span>
            <span class="cmdk-num">01</span>
          </button>
        </li>
        <li role="presentation">
          <button type="button" class="cmdk-item" role="option" data-cmdk-item data-cmdk-goto="experience">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"></rect><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"></path></svg>
            <span class="flex-1 text-left"><span data-locale="es">Experiencia</span><span data-locale="en" hidden>Experience</span></span>
            <span class="cmdk-num">02</span>
          </button>
        </li>
        <li role="presentation">
          <button type="button" class="cmdk-item" role="option" data-cmdk-item data-cmdk-goto="projects">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
            <span class="flex-1 text-left"><span data-locale="es">Proyectos</span><span data-locale="en" hidden>Projects</span></span>
            <span class="cmdk-num">03</span>
          </button>
        </li>
        <li role="presentation">
          <button type="button" class="cmdk-item" role="option" data-cmdk-item data-cmdk-goto="certifications">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="5"></circle><path d="m8.5 13.5-1.5 7 5-3 5 3-1.5-7"></path></svg>
            <span class="flex-1 text-left"><span data-locale="es">Certificaciones</span><span data-locale="en" hidden>Certifications</span></span>
            <span class="cmdk-num">04</span>
          </button>
        </li>
        <li role="presentation">
          <a class="cmdk-item" role="option" data-cmdk-item href={`mailto:${es.data.email}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 6-10 7L2 6"></path></svg>
            <span class="flex-1 text-left"><span data-locale="es">Contacto</span><span data-locale="en" hidden>Contact</span></span>
          </a>
        </li>
        {es.data.cv && (
          <li role="presentation">
            <button type="button" class="cmdk-item" role="option" data-cmdk-item data-cmdk-action="cv">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path></svg>
              <span class="flex-1 text-left"><span data-locale="es">Ver CV</span><span data-locale="en" hidden>View CV</span></span>
            </button>
          </li>
        )}
        <li role="presentation">
          <button type="button" class="cmdk-item" role="option" data-cmdk-item data-cmdk-action="top">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5"></path><path d="m5 12 7-7 7 7"></path></svg>
            <span class="flex-1 text-left"><span data-locale="es">Volver arriba</span><span data-locale="en" hidden>Back to top</span></span>
          </button>
        </li>
      </ul>
      <div class="cmdk-footer" aria-hidden="true">
        <span><kbd>↑↓</kbd> navegar</span>
        <span><kbd>↵</kbd> abrir</span>
        <span><kbd>esc</kbd> cerrar</span>
      </div>
    </div>
  </div>
</Base>

<script>
  import {
    browserLocaleStorage,
    persistLocale,
    resolveLocale,
    toggleLocale,
    type Locale,
  } from '../lib/i18n';

  const storage = browserLocaleStorage();
  let current = resolveLocale(storage);

  function applyLocale(locale: Locale) {
    document.documentElement.lang = locale;
    for (const el of document.querySelectorAll<HTMLElement>('[data-locale]')) {
      el.hidden = el.getAttribute('data-locale') !== locale;
    }
  }

  applyLocale(current);

  for (const button of document.querySelectorAll('[data-locale-toggle]')) {
    button.addEventListener('click', () => {
      current = toggleLocale(current);
      persistLocale(storage, current);
      applyLocale(current);
    });
  }
</script>
