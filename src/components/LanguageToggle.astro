---
// Presentational ES/EN switch. The page-level i18n script binds to the
// `[data-locale-toggle]` button and flips the `[data-locale]` labels below,
// so this component owns no state and imports no logic.
---

<button
  type="button"
  data-locale-toggle
  aria-label="Toggle language"
  class="rounded-md border border-hairline px-2.5 py-1 text-xs font-medium text-ink-subtle transition-colors hover:text-ink"
>
  <span data-locale="es">ES</span>
  <span data-locale="en" hidden>EN</span>
</button>
