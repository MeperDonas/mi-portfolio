---
import { render, type CollectionEntry } from 'astro:content';
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  title: string;
  presentLabel: string;
  entries: CollectionEntry<'experience'>[];
  hidden?: boolean;
}

const { locale, title, presentLabel, entries, hidden } = Astro.props;

const rendered = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);

function period(start: string, end: string | undefined): string {
  return end ? `${start} — ${end}` : `${start} — ${presentLabel}`;
}
---

{entries.length > 0 && (
  <section data-locale={locale} class="py-section" hidden={hidden || undefined}>
    <div class="mx-auto max-w-3xl px-6">
      <h2
        class="text-3xl font-semibold tracking-tight[-0.025em] text-ink sm:text-4xl"
        data-reveal
      >
        {title}
      </h2>
      <ol class="mt-10">
        {
          rendered.map(({ entry, Content }) => (
            <li class="flex gap-6" data-reveal>
              <div class="flex flex-col items-center">
                <span class="timeline-dot mt-2 h-2 w-2 shrink-0 rounded-full bg-primary"></span>
                <span class="timeline-line w-px flex-1 bg-hairline"></span>
              </div>
              <div class="pb-10">
                <h3 class="text-[22px] font-medium tracking-[-0.4px] text-ink">
                  {entry.data.role}
                </h3>
                <p class="mt-1 text-sm text-ink-muted">{entry.data.company}</p>
                <p class="mt-1 text-[12px] text-ink-subtle">
                  {period(entry.data.start, entry.data.end)}
                </p>
                <div class="mt-3 space-y-1 text-ink-muted">
                  <Content />
                </div>
                <ul class="mt-4 flex flex-wrap gap-2">
                  {entry.data.tags.map((tag) => (
                    <li class="rounded-sm border border-hairline px-2.5 py-1 text-[12px] text-ink-muted">
                      {tag}
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
)}
