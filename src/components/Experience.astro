---
import { render, type CollectionEntry } from 'astro:content';
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  title: string;
  presentLabel: string;
  entries: CollectionEntry<'experience'>[];
  hidden?: boolean;
}

const { locale, title, presentLabel, entries, hidden } = Astro.props;

const rendered = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);

function period(start: string, end: string | undefined): string {
  return end ? `${start} — ${end}` : `${start} — ${presentLabel}`;
}
---

{entries.length > 0 && (
  <section data-locale={locale} class="py-section" hidden={hidden || undefined}>
    <div class="mx-auto max-w-3xl px-6">
      <p class="font-mono text-sm text-accent" data-reveal>02.</p>
      <h2 class="mt-2 text-3xl font-semibold text-ink" data-reveal>{title}</h2>
      <ol class="mt-10">
        {
          rendered.map(({ entry, Content }) => (
            <li class="flex gap-6" data-reveal>
              <div class="flex flex-col items-center">
                <span class="mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full bg-accent"></span>
                <span class="w-px flex-1 bg-line"></span>
              </div>
              <div class="pb-10">
                <h3 class="text-lg font-semibold text-ink">{entry.data.role}</h3>
                <p class="mt-0.5 font-mono text-sm text-accent">{entry.data.company}</p>
                <p class="mt-1 font-mono text-xs text-faint">
                  {period(entry.data.start, entry.data.end)}
                </p>
                <div class="mt-3 space-y-1 text-muted">
                  <Content />
                </div>
                <ul class="mt-4 flex flex-wrap gap-2">
                  {entry.data.tags.map((tag) => (
                    <li class="rounded-full border border-line px-3 py-1 font-mono text-xs text-muted">
                      {tag}
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
)}
