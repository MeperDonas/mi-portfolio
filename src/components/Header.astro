---
import LanguageToggle from './LanguageToggle.astro';
import type { Locale } from '../lib/i18n';

export interface NavLabels {
  about: string;
  experience: string;
  projects: string;
  certifications: string;
  contact: string;
}

interface Props {
  brand: string;
  nav: Record<Locale, NavLabels>;
}

const { brand, nav } = Astro.props;

const links: { href: string; key: keyof NavLabels }[] = [
  { href: '#about', key: 'about' },
  { href: '#experience', key: 'experience' },
  { href: '#projects', key: 'projects' },
  { href: '#certifications', key: 'certifications' },
  { href: '#contact', key: 'contact' },
];
---

<header class="sticky top-0 z-50 border-b border-hairline bg-canvas">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-6">
    <a href="#top" class="flex items-center gap-2.5 text-[15px] font-medium text-ink">
      <span aria-hidden="true" class="inline-block h-3.5 w-3.5 rounded-xs bg-primary"></span>
      {brand}
    </a>

    <nav aria-label="Primary">
      <ul class="flex items-center gap-7 text-sm text-ink-subtle">
        {
          links.map(({ href, key }) => (
            <li class="hidden md:block">
              <a href={href} class="transition-colors hover:text-ink">
                <span data-locale="es">{nav.es[key]}</span>
                <span data-locale="en" hidden>{nav.en[key]}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <LanguageToggle />
  </div>
</header>
