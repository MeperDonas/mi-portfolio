---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  title: string;
  entries: CollectionEntry<'certifications'>[];
  hidden?: boolean;
}

const { locale, title, entries, hidden } = Astro.props;
---

{entries.length > 0 && (
<section data-locale={locale} class="py-section" hidden={hidden || undefined}>
  <div class="mx-auto max-w-3xl px-6">
    <h2 class="text-3xl font-bold text-ink">{title}</h2>
    <ul class="mt-10 space-y-4">
      {
        entries.map((entry) => (
          <li class="flex items-start justify-between gap-4 rounded-lg border border-line p-5">
            <div>
              <h3 class="font-semibold text-ink">{entry.data.title}</h3>
              <p class="mt-1 text-sm text-muted">{entry.data.issuer}</p>
            </div>
            <div class="text-right">
              <p class="text-sm text-muted">{entry.data.date}</p>
              {entry.data.url && (
                <a
                  href={entry.data.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-accent transition-colors hover:text-ink"
                >
                  ↗
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
)}
