---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  index: string;
  title: string;
  entries: CollectionEntry<'projects'>[];
  hidden?: boolean;
}

const { locale, index, title, entries, hidden } = Astro.props;
---

{entries.length > 0 && (
  <section data-locale={locale} class="py-section" hidden={hidden || undefined}>
    <div class="px-6">
      <p class="section-eyebrow" data-reveal>{index}</p>
      <h2 class="mt-4 text-display-md text-ink" data-reveal>
        {title}
      </h2>
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {
          entries.map((entry, i) => (
            <article class="card reveal-card group flex aspect-4/5 flex-col" data-reveal>
              <div class="flex items-start justify-between gap-4">
                <span class="project-index pt-1.5" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                {entry.data.url && (
                  <a
                    href={entry.data.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={entry.data.title}
                    class="project-link"
                  >
                    <svg
                      class="h-4 w-4"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M7 17L17 7M9 7h8v8"></path>
                    </svg>
                  </a>
                )}
              </div>
              <h3 class="mt-5 text-card-title text-ink">{entry.data.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-muted">{entry.data.description}</p>
              <ul class="mt-auto flex flex-wrap gap-2 border-t border-hairline pt-4">
                {entry.data.stack.map((tech) => (
                  <li class="tag">{tech}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>
)}
