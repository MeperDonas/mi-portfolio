---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  title: string;
  entries: CollectionEntry<'projects'>[];
  hidden?: boolean;
}

const { locale, title, entries, hidden } = Astro.props;
---

{entries.length > 0 && (
  <section data-locale={locale} class="py-section" hidden={hidden || undefined}>
    <div class="mx-auto max-w-6xl px-6">
      <h2
        class="text-3xl font-semibold tracking-[-0.025em] text-ink sm:text-4xl"
        data-reveal
      >
        {title}
      </h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {
          entries.map((entry) => (
            <article
              class="rounded-lg border border-hairline bg-surface-1 p-6 transition-colors hover:bg-surface-2"
              data-reveal
            >
              <div class="flex items-start justify-between gap-4">
                <h3 class="text-[22px] font-medium tracking-[-0.4px] text-ink">
                  {entry.data.title}
                </h3>
                {entry.data.url && (
                  <a
                    href={entry.data.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={entry.data.title}
                    class="text-ink-subtle transition-colors hover:text-primary"
                  >
                    <svg
                      class="h-4 w-4"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M7 17L17 7M9 7h8v8"></path>
                    </svg>
                  </a>
                )}
              </div>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted">{entry.data.description}</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {entry.data.stack.map((tech) => (
                  <li class="rounded-sm border border-hairline px-2.5 py-1 text-[12px] text-ink-muted">
                    {tech}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>
)}
