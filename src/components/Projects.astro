---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  title: string;
  entries: CollectionEntry<'projects'>[];
  hidden?: boolean;
}

const { locale, title, entries, hidden } = Astro.props;
---

{entries.length > 0 && (
  <section data-locale={locale} class="py-section" hidden={hidden || undefined}>
    <div class="mx-auto max-w-5xl px-6">
      <p class="font-mono text-sm text-accent" data-reveal>03.</p>
      <h2 class="mt-2 text-3xl font-semibold text-ink" data-reveal>{title}</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {
          entries.map((entry) => (
            <article
              class="group rounded-xl border border-line bg-surface p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-accent hover:shadow-lg"
              data-reveal
            >
              <div class="flex items-start justify-between gap-4">
                <h3 class="text-lg font-semibold text-ink">{entry.data.title}</h3>
                {entry.data.url && (
                  <a
                    href={entry.data.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={entry.data.title}
                    class="text-muted transition-colors hover:text-accent"
                  >
                    <svg
                      class="h-4 w-4"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M7 17L17 7M9 7h8v8"></path>
                    </svg>
                  </a>
                )}
              </div>
              <p class="mt-2 text-sm leading-relaxed text-muted">{entry.data.description}</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {entry.data.stack.map((tech) => (
                  <li class="rounded-full border border-line px-3 py-1 font-mono text-xs text-muted">
                    {tech}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>
)}
