---
import { render, type CollectionEntry } from 'astro:content';
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  index: string;
  entries: CollectionEntry<'about'>[];
  hidden?: boolean;
}

const { locale, index, entries, hidden } = Astro.props;

const rendered = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);
---

{entries.length > 0 && (
  <section data-locale={locale} class="py-section" hidden={hidden || undefined}>
    <div class="mx-auto max-w-3xl px-6">
      {
        rendered.map(({ entry, Content }) => (
          <div>
            <p class="section-eyebrow" data-reveal>{index}</p>
            <h2 class="mt-4 text-display-md text-ink" data-reveal>
              {entry.data.title}
            </h2>
            <p class="mt-6 text-subhead text-ink" data-reveal>{entry.data.lead}</p>
            <div class="rich-text mt-6 leading-relaxed text-ink-muted" data-reveal>
              <Content />
            </div>
          </div>
        ))
      }
    </div>
  </section>
)}
