---
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  name: string;
  role: string;
  hidden?: boolean;
}

const { locale, name, role, hidden } = Astro.props;

const status = locale === 'es' ? '> disponible para trabajar' : '> available for work';
const cta = locale === 'es' ? 'Contactar' : 'Get in touch';
---

<section
  data-locale={locale}
  class="flex min-h-[85vh] items-center justify-center px-6"
  hidden={hidden || undefined}
>
  <div class="max-w-3xl text-center">
    <p class="text-[13px] font-medium tracking-[0.4px] text-ink-subtle" data-reveal>{role}</p>
    <h1
      class="mt-5 text-5xl font-semibold tracking-[-0.03em] text-ink sm:text-6xl"
      data-reveal
    >
      {name}
    </h1>
    <p class="mt-6 font-mono text-[13px] text-ink-subtle" data-reveal>{status}</p>
    <div class="mt-10" data-reveal>
      <a
        href="#contact"
        class="inline-flex items-center justify-center rounded-md bg-primary px-3.5 py-2 text-sm font-medium text-on-primary transition-colors hover:bg-primary-hover active:bg-primary-focus"
      >
        {cta}
      </a>
    </div>
  </div>
</section>
