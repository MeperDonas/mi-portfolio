---
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  title: string;
  email: string;
  hidden?: boolean;
}

const { locale, title, email, hidden } = Astro.props;
---

<section data-locale={locale} class="py-section" hidden={hidden || undefined}>
  <div class="px-6 text-center">
    <h2 class="text-3xl font-semibold tracking-[-0.025em] text-ink sm:text-4xl" data-reveal>
      {title}
    </h2>
    <p class="mt-6" data-reveal>
      <a
        href={`mailto:${email}`}
        class="text-lg text-primary transition-colors hover:text-primary-hover"
      >
        {email}
      </a>
    </p>
  </div>
</section>
