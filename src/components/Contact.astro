---
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  title: string;
  email: string;
  linkedin: string;
  github: string;
  hidden?: boolean;
}

const { locale, title, email, linkedin, github, hidden } = Astro.props;
---

<section data-locale={locale} class="py-section" hidden={hidden || undefined}>
  <div class="mx-auto max-w-3xl px-6 text-center">
    <h2 class="text-3xl font-bold text-ink">{title}</h2>
    <p class="mt-4 text-muted">
      <a href={`mailto:${email}`} class="text-accent hover:underline">
        {email}
      </a>
    </p>
    <div class="mt-6 flex flex-wrap items-center justify-center gap-4">
      <a
        href={linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full border border-line px-5 py-2 text-sm font-medium text-muted transition-colors hover:border-accent hover:text-accent"
      >
        LinkedIn
      </a>
      <a
        href={github}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full border border-line px-5 py-2 text-sm font-medium text-muted transition-colors hover:border-accent hover:text-accent"
      >
        GitHub
      </a>
    </div>
  </div>
</section>
